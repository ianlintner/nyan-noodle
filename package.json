{
  "name": "nyan-noodle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nyan Noodle — cozy browser cat-ramen shop management game (Phaser 4 + TypeScript + Vite).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run validate-assets && npm run build",
    "assets:generate": "node scripts/generate-art.mjs",
    "assets:icons": "node scripts/generate-icons.mjs",
    "validate-assets": "node scripts/validate-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:headless": "tsx scripts/sim-headless.ts",
    "build": "npm run build -w @nyan-noodle/game",
    "dev": "npm run dev -w @nyan-noodle/game",
    "preview": "npm run preview -w @nyan-noodle/game",
    "e2e": "playwright test",
    "e2e:subpath": "E2E_BASE_PATH=/nyan-noodle/ playwright test e2e/hosting.spec.ts",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.1.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
